# ============================================================================
# SDOC Hackathon 2026 · environment template
# Copy to `.env` and fill in. `.env` is git-ignored: never commit it, never paste it.
#
# ★ The model IDs below were verified live in 2026-09 — see GEMINI_*_CANDIDATES.
#   Do NOT reintroduce gemini-2.5-pro / gemini-2.5-flash: they return 404 for new
#   accounts, and the free tier grants limit: 0 input quota on the pro series (429).
# ============================================================================

# ---------- AI engine (required for the generative channel) ----------
# Leave blank to run the deterministic expert-rules channel only — the graded
# baseline reproduces without any API key.
GEMINI_API_KEY=
# Two tiers: a light model routes intent, a strong model does multimodal extraction.
GEMINI_MODEL_CLASSIFY=gemini-3.1-flash-lite
GEMINI_MODEL_EXTRACT=gemini-3.6-flash
# Failover target when the primary model is unavailable (blank = primary only).
GEMINI_MODEL_FALLBACK=gemini-3.5-flash
# Flash tiers can skip thinking (faster routing, cheaper); keep the extract tier at
# 0 as well so thinking tokens cannot truncate the JSON response.
GEMINI_CLASSIFY_THINKING=0
GEMINI_EXTRACT_THINKING=0
# Thinking tokens count against max_output_tokens on 2.5/3.x — too small truncates JSON.
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_CONCURRENCY=8
# Hard per-call timeout (seconds): one slow request must not hold a concurrency slot.
GEMINI_TIMEOUT_S=120
# Content-addressed cache: re-running 520 emails after a prompt change costs ~nothing.
GEMINI_CACHE=1
GEMINI_CACHE_DIR=.cache/gemini
# Probe the candidate chain once at startup with a real tiny request; cached 24h (0 = skip).
GEMINI_MODEL_PROBE=1
GEMINI_PLAN_TTL_H=24
# Manually pin candidate order (comma-separated, optional; merged with the built-in chain).
GEMINI_CLASSIFY_CANDIDATES=
GEMINI_EXTRACT_CANDIDATES=

# ---------- Supabase (required by the console and for cloud persistence) ----------
SUPABASE_URL=
# The service-role key belongs on the server only. It must never appear in frontend/.
SUPABASE_SERVICE_ROLE_KEY=
# Write resilience: per-request timeout and exponential backoff attempts.
SUPABASE_TIMEOUT_S=30
SUPABASE_MAX_ATTEMPTS=4

# ---------- Data source ----------
# `data` for the local static corpus; http://localhost:8080 for the organiser service.
INBOX_SOURCE=data
INBOX_DATA_DIR=data
PROMPT_VERSION=v3

# ---------- Self-scoring ----------
SUBMIT_URL=http://localhost:8080
GROUND_TRUTH_PATH=eval/private/ground_truth.json
SCORING_PATH=server/scoring.py

# ---------- Services & frontend ----------
API_PORT=8000
API_RELOAD=1
# Set to the frontend origin on deploy (comma-separated); localhost only by default.
CORS_ORIGINS=http://localhost:3000
# Public (browser-visible) variable: the FastAPI origin (Railway domain on Vercel).
NEXT_PUBLIC_API_BASE=http://localhost:8000

# ---------- ROI assumptions (live-tunable, shown on screen) ----------
ROI_HUMAN_MINUTES_PER_PAIR=20
ROI_USD_PER_HUMAN_HOUR=65
ROI_MONTHLY_PAIRS=400
ROI_USD_PER_1M_INPUT=0.30
ROI_USD_PER_1M_OUTPUT=2.50
# Measured per-email token footprint (from tools.live_smoke: 6584 in / 1104 out over 2 calls).
ROI_TOKENS_IN_PER_EMAIL=3292
ROI_TOKENS_OUT_PER_EMAIL=552
